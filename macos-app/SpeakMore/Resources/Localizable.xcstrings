    "setup.modelDesc.sensevoice-small": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原版 PyTorch 权重；运行时内存约 3 GB，可用 CUDA / MPS 加速。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original PyTorch weights; about 3 GB of memory while running, can use CUDA / MPS."
          }
        }
      }
    },
    "setup.modelDesc.sensevoice-small-int8": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同一模型的 int8 量化版：体积约为原版四分之一，CPU 识别约快一倍，内存约 400 MB；只在 CPU 上运行，识别结果与原版约 99% 一致。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "int8-quantized version of the same model: about a quarter of the size, roughly twice as fast on CPU, about 400 MB of memory; CPU only, results match the original about 99% of the time."
          }
        }
      }
    },

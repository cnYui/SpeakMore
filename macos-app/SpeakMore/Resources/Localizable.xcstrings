    "setup.modelListHint": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以只下载一个，也可以全部下载后随时切换；切换后会自动加载新模型。从 PyTorch 版切到 int8 版后，重启 SpeakMore 才会释放之前占用的内存。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download one or all of them and switch at any time; the selected model is loaded automatically. After switching from the PyTorch model to int8, restart SpeakMore to free the memory it used."
          }
        }
      }
    },
